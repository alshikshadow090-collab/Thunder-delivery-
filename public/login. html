<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="UTF-8">
<title>Thunder Login</title>
<style>
body{background:linear-gradient(135deg,#1e3a8a,#7c3aed);min-height:100vh;padding:20px;display:flex;align-items:center;justify-content:center;font-family:sans-serif;margin:0}
.c{background:#fff;border-radius:20px;padding:28px;max-width:400px;width:100%}
h1{text-align:center;color:#1e3a8a;margin:0 0 20px}
input{width:100%;padding:14px;border:2px solid #ddd;border-radius:10px;font-size:15px;margin-bottom:12px;box-sizing:border-box}
button{width:100%;padding:14px;background:#1e3a8a;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700}
#m{padding:12px;border-radius:8px;margin-top:12px;text-align:center;display:none}
.e{background:#fee;color:#900;display:block}
.o{background:#dfc;color:#163;display:block}
</style>
</head>
<body>
<div class="c">
<h1>Thunder Delivery</h1>
<input id="p" value="+249912345678" placeholder="رقم">
<input id="w" type="password" value="test1234" placeholder="كلمة المرور">
<button id="b" onclick="L()">دخول</button>
<div id="m"></div>
</div>
<script>
async function L(){
var b=document.getElementById("b"),m=document.getElementById("m");
b.disabled=1;m.className="";
try{
var r=await fetch("/api/auth/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({phone:document.getElementById("p").value,password:document.getElementById("w").value})});
var d=await r.json();
if(!r.ok)throw Error(d.error);
localStorage.setItem("token",d.token);
localStorage.setItem("user",JSON.stringify(d.user));
m.className="o";m.textContent="OK "+d.user.full_name;
setTimeout(function(){location.href="/app.html"},1000);
}catch(e){m.className="e";m.textContent=e.message}
finally{b.disabled=0}
}
</script>
</body>
</html>